+            clicMoletteAvale   = m_cursorSurfaceInfo.name == "text" && !(FENETRE && FENETRE->m_class == "firefox");
+        }
+        if (clicMoletteAvale) {
+            if (e.state == WL_POINTER_BUTTON_STATE_RELEASED)
